rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation
    function isValidTier(tier) {
      return tier in ['Gintaras', 'Gelezis', 'Bronza', 'Sidabras', 'Auksas', 'Platina', 'Deimantas', 'Meistras'];
    }

    function isValidBattleData() {
      let data = request.resource.data;
      return data.id is string
        && data.id.size() >= 3
        && data.id.size() <= 20
        && data.status in ['waiting', 'in_progress', 'finished']
        && data.currentRound is int
        && data.currentRound >= 0
        && data.currentRound <= 10
        && data.createdAt is number
        && data.size() <= 15;
    }

    // 1. User Profiles & Progress: Strict user ownership
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections under user (e.g. mistakes, history)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Amber League Leaderboard: Authenticated users can read standings, and write only their own entry with validated bounds
    match /leaderboard/{tier}/members/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidTier(tier)
                   && request.resource.data.userId == request.auth.uid
                   && request.resource.data.xp is int
                   && request.resource.data.xp >= 0
                   && request.resource.data.xp <= 500000
                   && request.resource.data.streak is int
                   && request.resource.data.streak >= 0
                   && request.resource.data.streak <= 3650
                   && request.resource.data.displayName is string
                   && request.resource.data.displayName.size() <= 50;
    }

    // 3. Friend Battle Rooms: Validated room schema, read with room code, no arbitrary deletion
    match /battles/{battleId} {
      allow read: if true;
      allow create, update: if isValidBattleData();
      allow delete: if false; // Prevent attackers from wiping active battles
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
